<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>br.com.unipds</groupId>
        <artifactId>cotuba</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>cotuba-cli</artifactId>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>br.com.unipds</groupId>
            <artifactId>cotuba-application</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>br.com.unipds</groupId>
            <artifactId>cotuba-config</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>br.com.unipds</groupId>
            <artifactId>cotuba-md</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>br.com.unipds</groupId>
            <artifactId>cotuba-pdf</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>br.com.unipds</groupId>
            <artifactId>cotuba-epub</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>br.com.unipds</groupId>
            <artifactId>cotuba-html</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>commons-cli</groupId>
            <artifactId>commons-cli</artifactId>
            <version>1.11.0</version>
        </dependency>

        <dependency>
            <groupId>org.jmolecules.integrations</groupId>
            <artifactId>jmolecules-archunit</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.4.1</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>br.com.unipds.cotuba.adapters.in.cli.Main</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>